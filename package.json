{
  "name": "hex-fall",
  "version": "0.1.0",
  "private": true,
  "description": "Online survival game on Hex puzzles, with PlayHex accounts",
  "type": "module",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env src/server/index.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/server/commands/migrate.ts",
    "puzzles:import": "tsx --env-file-if-exists=.env src/server/commands/import-puzzles.ts",
    "puzzles:export": "tsx --env-file-if-exists=.env src/server/commands/export-puzzles.ts",
    "puzzles:stats": "tsx --env-file-if-exists=.env src/server/commands/puzzle-stats.ts"
  },
  "dependencies": {
    "@playhex/conditional-moves": "^1.0.0",
    "@playhex/move-notation": "^1.0.0",
    "@playhex/pixi-board": "^1.0.0",
    "@playhex/shading-patterns": "^1.0.0",
    "@tanstack/vue-table": "^9.3.1",
    "bootstrap": "^5.3.9",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "events": "^3.3.0",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "pinia": "^4.1.0",
    "pixi.js": "^8.23.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tiny-typed-emitter": "^2.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/events": "^3.0.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.21.0"
}
