# Port of the Hex Fall server (API + socket.io). In production, also serves the built client.
PORT=3700

# Development only: port of the Vite dev server, which proxies /api, /login, /callback, /logout and /socket.io to PORT.
# Keep APP_URL and the OAuth redirect URI in sync with it.
CLIENT_PORT=5173

# Public URL of Hex Fall, as seen by the browser (Vite dev server in development).
# Also used to build the OAuth redirect URI: APP_URL/callback
APP_URL=http://localhost:5173

# Hex Fall own MySQL database (create it first: CREATE DATABASE hexfall)
DATABASE_URL=mysql://root:root@127.0.0.1:13306/hexfall

# PlayHex instance used for login and player profiles (http://localhost:13000 for PlayHex dev)
PLAYHEX_URL=http://localhost:13000

# PlayHex OAuth confidential client, see README "PlayHex OAuth client"
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Random secret used to sign cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=change-me

# 32 bytes hex key to encrypt PlayHex OAuth tokens in database (same command as above)
TOKEN_ENCRYPTION_KEY=

# Comma separated PlayHex publicIds allowed to see /admin/puzzles
ADMIN_PUBLIC_IDS=
