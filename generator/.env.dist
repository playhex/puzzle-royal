# Puzzle generator configuration, read by generate.py.
# To override a variable, set it in generator/.env (gitignored) or in the environment.
# Priority: environment > generator/.env > generator/.env.dist > project .env (for DATABASE_URL).
# Paths can start with ~, relative paths are relative to the project root.

# --- Tools ---

# Katahex plays the self-play games, Mohex checks every candidate position.
# Measured speed: 1 Katahex ~85 positions/s, 4 Mohex ~13 positions/s (~3 per Mohex),
# so Mohex is the bottleneck and Katahex waits most of the time.

# Mohex executable (benzene).
MOHEX=~/dev/playhex/benzene-vanilla-cmake/build/src/mohex/mohex

# Number of Mohex processes checking positions. Each one takes ~700 MB (dfpn transposition table).
MOHEX_PROCESSES=4

# Maximum number of Mohex processes running at once, other Mohex processes (e.g. a PlayHex worker) included:
# fewer than MOHEX_PROCESSES are started when some are already running.
MAX_MOHEX=4

# Mohex dfpn time limit per solve, in seconds. 7x7 solves take a few ms to 1 s.
MOHEX_TIMELIMIT=20

# Katahex executable, config and model.
KATAHEX=~/dev/playhex/katahex/build/katahex
KATAHEX_CONFIG=~/dev/playhex/hex-ai-distributed/katahex/config.cfg
KATAHEX_MODEL=~/dev/playhex/hex-ai-distributed/katahex/katahex_model_20220618.bin.gz

# Number of Katahex processes playing games. One is enough for ~25 Mohex processes.
KATAHEX_PROCESSES=1

# --- Database ---

# Hex Fall MySQL database. Its puzzles are excluded by the similarity check (read with the mysql client).
# Empty: DATABASE_URL of the project .env. Not needed with --no-db.
DATABASE_URL=

# --- Files ---

# Folder of generated batches: batch-<n>.json are written here.
BATCHES_DIR=generator/batches

# --- Puzzle rules ---

# Self-play temperatures, comma separated: one is picked at random per game.
# Higher plays sloppier games (more mistakes to punish), lower plays cleaner games.
SELFPLAY_TEMPERATURES=0.6,0.8,1.0,1.2

# Number of stones on the board of a candidate position, bounds included.
MIN_STONES=6
MAX_STONES=18

# A puzzle is rejected when an existing puzzle has the same solution and at most this many differing stones
# (180° rotation included). 0 only rejects identical positions.
SIMILAR_MAX_DIFF=4
